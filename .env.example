# GitHub Credentials for cloning the repository
# Create a Personal Access Token (PAT) with 'repo' scope
GITHUB_TOKEN=your_github_token_here

# The GitHub repository URL without the https:// prefix
GITHUB_REPO=github.com/yourusername/studium-catalogue.git

# Cloudflare Tunnel Configuration
# Get this from your Cloudflare Zero Trust Dashboard
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Paths & Network
# Local path on your host machine to map to the container's data folder
DATA_DIR=/opt/studium-catalogue

# Optional: Host port to expose (e.g. 3000). 
# If you only want to access via Cloudflare tunnel, you can leave this empty or comment it out in the compose file.
PORT=3000
